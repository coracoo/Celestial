{
  "name": "celestial-heroes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Celestial Heroes — 3D 柏青哥 × 娘化 108 将卡牌收集 × 三卡 Build × 技能连携",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test scripts/*.test.ts",
    "smoke": "node --experimental-strip-types scripts/smoke.ts",
    "art": "node --experimental-strip-types scripts/genart.ts",
    "ui": "node --experimental-strip-types scripts/genui.ts",
    "art:all": "npm run art && npm run ui"
  },
  "dependencies": {
    "@dimforge/rapier2d-compat": "^0.21.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@imgly/background-removal-node": "^1.4.5",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
